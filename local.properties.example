## Copy to local.properties (gitignored) and fill in your values.
## Do NOT commit local.properties.

sdk.dir=C\:\\Users\\YOU\\AppData\\Local\\Android\\Sdk

# Telegram API (https://my.telegram.org) — required for a working login
TELEGRAM_APP_ID=12345
TELEGRAM_APP_HASH=your_app_hash_here

# Optional AI / maps / SafetyNet
OPENROUTER_API_KEY=
SAFETYNET_API_KEY=
MAPS_API_KEY=

# WS bypass on mglabot (must match MGLA_WS_TOKEN in /opt/mgla-ws-relay/env there)
MGLA_WS_RELAY_HOST=mglabot.mooo.com
MGLA_WS_RELAY_TOKEN=

# Stats panel on mglahub (optional; AI does NOT use this — AI goes via MGLA_WS_RELAY_HOST)
MGLA_HUB_HOST=mglahub.mooo.com
MGLA_HUB_TOKEN=
